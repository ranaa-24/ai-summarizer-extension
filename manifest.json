{
  "manifest_version": 3,
  "name": "QuickSummary",
  "version": "1.0.0",
  "description": "Quickly get the gist of any article with QuickSummary — your smart summarizer that turns long reads into clear, bite-sized insights. Save time, stay informed",
  "permissions": ["scripting", "storage", "activeTab"],

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png",
    "default_title": "Summarize this page"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": ["<all_urls>"],

  "options_page": "options.html"
}
